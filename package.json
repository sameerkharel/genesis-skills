{
  "name": "genesis-code",
  "version": "2.0.0",
  "description": "Zero-dependency deterministic verification gate, real test-gated auto-rollback ratchet, cross-session failure memory, and dependency DAG scanner for AI coding agents (Antigravity, Claude Code, Cursor, Gemini CLI).",
  "keywords": [
    "ai-coding-agents",
    "agent-skills",
    "claude-code-hooks",
    "antigravity",
    "cursor-rules",
    "deterministic-verification",
    "auto-rollback",
    "dependency-dag",
    "failure-memory"
  ],
  "bin": {
    "genesis-code": "./bin/genesis-code.mjs"
  },
  "scripts": {
    "init": "node ./bin/genesis-code.mjs init",
    "prepare-code": "npx --yes tsx ./src/cli.ts prepare",
    "verify-code": "npx --yes tsx ./src/cli.ts verify",
    "audit-code": "npx --yes tsx ./src/cli.ts audit",
    "lessons": "npx --yes tsx ./src/cli.ts lessons",
    "test": "npx --yes tsx --test ./tests/genesis-code.test.ts",
    "benchmark:compare": "npx --yes tsx --test ./tests/compare-v2-vs-dist.test.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
